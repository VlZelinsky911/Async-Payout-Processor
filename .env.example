# Application Port
PORT=3000

# Run as a background worker only (consumer, no HTTP listener). Default: false.
WORKER_ONLY=false

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=challenge_user
POSTGRES_PASSWORD=challenge_password
POSTGRES_DB=challenge_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Payout consumer tuning
PAYOUT_BLOCK_MS=5000          # how long XREADGROUP blocks waiting for new events
PAYOUT_BATCH_SIZE=10          # max messages pulled per read
PAYOUT_MAX_RETRIES=3          # deliveries before a message is sent to the DLQ
PAYOUT_CLAIM_IDLE_MS=30000    # idle time before a dead consumer's messages are claimed
